# macOS
.DS_Store

# Slide content — release one session at a time.
# To publish a session, add a `!` line for its .md and .pdf.
slides/decks/*
!slides/decks/.gitkeep
!slides/decks/theme.css
!slides/decks/session1.md
!slides/decks/session1.pdf
!slides/decks/session2.md
!slides/decks/session2.pdf
!slides/decks/session3.md
!slides/decks/session3.pdf
!slides/decks/session4.md
!slides/decks/session4.pdf
slides/assets/*
!slides/assets/.gitkeep
!slides/assets/*.svg

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/

# Editor
.vscode/
.idea/

# Claude Code local state (keep shared settings.json tracked)
.claude/*
!.claude/settings.json

# Local copy of CLAUDE.md for other agent CLIs
AGENTS.md

# Session 2 replication demo — local clone of shade-econ/sequence-jacobian
# (an external repo with its own .git; not part of this repo)
replication/

# Demo paper corpus — copyrighted PDFs; kept untracked on this public repo.
# Folder structure and notes (README/summary) are tracked; PDFs are not.
# Distribute the PDFs to students through a private channel, not git.
papers/**/*.pdf

# Lit-review demo run-notes — instructor copy; the run prompts live in the slides.
papers/litreview/README.md

# Participant roster (PII)
Participants_AI Course.pdf
